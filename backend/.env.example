# Application Runtime
APP_NAME=gridbricks-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=2

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gridbricks

# Elexon BMRS API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3
ELEXON_BACKOFF_FACTOR=1.5
ELEXON_USER_AGENT=Gridbricks-Procurement-Analytics/1.0 (Energy Procurement)

# Temporal & Market Rules Configuration
DECISION_DATE_MODE=DECISION_DATE
DECISION_TIMEZONE=Europe/London

DECISION_CUTOFF_LOCAL_TIME=10:00
DECISION_LEAD_DAYS=1
DECISION_CUTOFF_INCLUSIVE=true

FORECAST_LOOKBACK_HOURS=72


FORECAST_SELECTION_POLICY=latest_complete_publication
SNAPSHOT_FALLBACK_POLICY=latest_per_interval
# Threshold of expected intervals
SNAPSHOT_COMPLETENESS_THRESHOLD=0.95

# Forecast interval alignment: EXACT (only match :00 intervals) or STEP_FORWARD (carry :00 into :30)
FORECAST_INTERVAL_ALIGNMENT=STEP_FORWARD

# Upstash Redis
UPSTASH_REDIS_URL=
CACHE_TTL_SECONDS=1800

# Upstash QStash Configuration
QSTASH_URL=https://qstash.upstash.io/v2/publish
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Hugging Face LLM Configuration
HUGGINGFACE_API_KEY=
HF_LLAMA_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
ENABLE_LLM_SUMMARY=true

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
API_KEY_ADMIN=
